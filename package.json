{
  "name": "hubspot-asana-handoff",
  "version": "0.1.0",
  "description": "HubSpot webhooks in: route new leads to the right salesperson, and hand a won deal over to production as an Asana project.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo.ts",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "live": "tsx src/live.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  }
}
